{% extends 'layouts/dashboard.html.twig' %}

{% block content %}
  <div class="row mb-3">
    <div class="col-12">
      <div class="page-title-box d-sm-flex align-items-center justify-content-between">
        <h4 class="mb-sm-0">{% if form.vars.value.id %}Modifier l'étiquette{% else %}Nouvelle étiquette{% endif %}</h4>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      {{ form_start(form, {'attr': {'class': 'row g-3 align-items-center'}}) }}
          
        {# Champs nom #}
        {{ form_row(form.name) }}
        
        {# Champs description #}
        {{ form_row(form.description) }}

        {# Label global pour l'accessibilité et la cohérence #}
        <div class="col-12">
          <label class="form-label fw-semibold">Couleur</label>
        </div>

        <div class="col-12 form-selectable custom-form-selectable js-selectable-container d-flex gap-2" data-ds-selectable-card-behavior="radio" style="margin-top: 0;">
          {% for child in form.color %}
            <div class="form-selectable-item">
              
              <input type="radio" 
                id="{{ child.vars.id }}" 
                name="{{ child.vars.full_name }}" 
                value="{{ child.vars.value }}" 
                class="form-selectable-input"
                {% if child.vars.checked %}checked="checked"{% endif %}
              >
                      
              <label 
                class="form-selectable-label color-swatch bg-{{ child.vars.value }}" 
                for="{{ child.vars.id }}"
                title="{{ child.vars.label }}"
              ></label>
                  
            </div>
          {% endfor %}
        </div>
        {# 🔴 LA LIGNE MAGIQUE POUR EMPÊCHER LE DOUBLON 🔴 #}
        {% do form.color.setRendered() %}
        {{ form_errors(form.color) }}

        <div class="col-auto">
          {{ form_widget(form.save) }}
          <a href="{{ path('auth_profile_index', {'t': 'tags'}) }}" class="btn btn-light ms-2">Annuler</a>
        </div>
          
      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}

{% block js %}
  <script src="{{ asset('js/pages/auth/profile.js') }}"></script>
{% endblock %}