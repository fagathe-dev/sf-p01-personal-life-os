<div class="card shadow-none border mb-0">
  <div class="card-header d-flex align-items-center pb-3">
    <h5 class="card-title mb-0 flex-grow-1">Liste de vos étiquettes</h5>
    <div class="flex-shrink-0">
      <a href="{{ path('auth_profile_tag_create') }}" class="btn btn-primary btn-sm">
        <i class="ri-add-line align-bottom me-1"></i> Ajouter une étiquette
      </a>
    </div>
  </div>
    
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th scope="col" style="width: 30%; padding-left: 1.5rem;">Étiquette</th>
        <th scope="col">Couleur (système)</th>
        <th scope="col">Description</th>
        <th scope="col" class="text-end" style="padding-right: 1.5rem;">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for tag in tags %}
        <tr>
          <td style="padding-left: 1.5rem;">
            <span class="badge rounded-pill bg-{{ tag.color.value }} px-3 py-2 fs-14">
              {{ tag.name }}
            </span>
          </td>
          <td class="text-muted">
            <code>{{ tag.color.value }}</code>
          </td>
          <td class="text-muted">
            <code>{{ tag.description }}</code>
          </td>
          <td class="text-end" style="padding-right: 1.5rem;">
            <div class="dropdown d-inline-block">
              <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="ri-more-fill align-middle"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li>
                  <a href="{{ path('auth_profile_tag_edit', {'id': tag.id}) }}" class="dropdown-item edit-item-btn">
                    <i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Modifier
                  </a>
                </li>
                <li>
                  <a href="#" class="dropdown-item remove-item-btn text-danger" data-bs-toggle="modal" data-bs-target="#deleteTagModal{{ tag.id }}">
                    <i class="ri-delete-bin-fill align-bottom me-2"></i> Supprimer
                  </a>
                </li>
              </ul>
            </div>

              <div class="modal fade" id="deleteTagModal{{ tag.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content text-start">
                    <div class="modal-header">
                      <h5 class="modal-title">Confirmer la suppression</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <p>Êtes-vous sûr de vouloir supprimer l'étiquette <strong>{{ tag.name }}</strong> ?</p>
                      <p class="text-muted fs-13 mb-0">Cette action est irréversible et retirera ce tag de toutes vos notes et tâches.</p>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                      <form action="{{ path('auth_profile_tag_delete', {'id': tag.id}) }}" method="POST" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_tag' ~ tag.id) }}">
                        <button type="submit" class="btn btn-danger">Oui, supprimer</button>
                      </form>
                    </div>
                  </div>
                </div>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="3" class="text-center py-4 text-muted">Aucune étiquette créée pour le moment.</td>
        </tr>
        {% endfor %}
    </tbody>
  </table>
  <div class="card-body p-0">
    <div class="table-responsive">
    </div>
  </div>
</div>