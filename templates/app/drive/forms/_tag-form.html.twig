{# templates/app/drive/forms/_tag-form.html.twig #}

<div id="modalTagForm" class="modal fade" tabindex="-1" aria-labelledby="modalTagFormLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow">
      
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fs-15 fw-semibold" id="modalTagFormLabel">Gérer l'étiquette</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="driveFileTagForm" action="#" method="post">
        <div class="modal-body">
          
          <div class="form-group mb-0">
            {# Conteneur piloté par SelectableField #}
            <div class="form-selectable custom-form-selectable js-tag-selectable-container d-flex flex-wrap gap-3 justify-content-center py-3">
              
              {% for tag in userTags|default([]) %}
                <div class="form-selectable-item">
                  <input type="radio" 
                    id="drive_tag_{{ tag.id }}" 
                    name="tag_id" 
                    value="{{ tag.id }}" 
                    class="form-selectable-input d-none">
                    
                  {# Pastille de couleur avec infobulle #}
                  <label class="form-selectable-label color-swatch bg-{{ tag.color.value }}" 
                    for="drive_tag_{{ tag.id }}"
                    title="{{ tag.name }}"
                    data-bs-toggle="tooltip">
                  </label>
                </div>
              {% else %}
                <p class="text-muted fs-13 mb-0 text-center">Aucune étiquette disponible.</p>
              {% endfor %}

            </div>
          </div>

        </div>
        
        <div class="modal-footer border-top-0 pt-0">
          <button type="submit" class="btn btn-primary w-100 shadow-sm d-none">Enregistrer</button>
        </div>
      </form>

    </div>
  </div>
</div>