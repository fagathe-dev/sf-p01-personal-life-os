{# templates/app/drive/forms/_tag-form.html.twig #}

<div id="modalTagForm" class="modal fade" tabindex="-1" aria-labelledby="modalTagFormLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content border-0 shadow">
      
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fs-15 fw-semibold" id="modalTagFormLabel">Gérer l'étiquette</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      {# L'action sera injectée dynamiquement par le JS #}
      <form id="driveFileTagForm" action="#" method="post">
        <div class="modal-body">
          
          <div class="form-group mb-0">
            {# 
              Zone ciblée par new CustomSelector() en TypeScript 
              Le mode 'nullable' permet de décocher un tag actif
            #}
            <div data-input-id="drive_file_tag" data-cds-mode="nullable" data-cds-placeholder="Sélectionner une étiquette...">
              {# On boucle sur les tags de l'utilisateur passés par le contrôleur #}
              {% for tag in userTags|default([]) %}
                <label class="d-flex align-items-center mb-2" style="cursor: pointer;">
                  <input type="radio" name="tag_id" value="{{ tag.id }}" class="d-none">
                  <span class="badge border border-light text-body bg-white shadow-sm py-2 px-3 w-100 text-start">
                    {% if tag.color %}
                      <span class="rounded-circle d-inline-block me-2 bg-{{ tag.color.value }}" style="width: 8px; height: 8px;"></span>
                    {% endif %}
                    {{ tag.name }}
                  </span>
                </label>
              {% else %}
                <p class="text-muted fs-13 mb-0 text-center">Aucune étiquette disponible.</p>
              {% endfor %}
            </div>
          </div>

        </div>
        
        <div class="modal-footer border-top-0 pt-0">
          <button type="submit" class="btn btn-primary w-100 shadow-sm">Enregistrer</button>
        </div>
      </form>

    </div>
  </div>
</div>