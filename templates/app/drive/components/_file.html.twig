{# templates/app/drive/components/_file.html.twig #}

{# On récupère le tableau {icon, color} via ton filtre #}
{% set iconData = file.extension|file_icon %}

<tr data-drive-item="file" data-item-id="{{ file.id }}">
  <th scope="row">
    <div class="d-flex align-items-center gap-2">
      <i class="{{ iconData.icon }} text-{{ iconData.color }} align-bottom fs-5"></i>
      <span class="item-name text-truncate">{{ file.niceName ?: file.originalName }}</span>
      
      {# --- PILULE DU TAG (Style Finder) --- #}
      <span 
        class="tag-pill-trigger d-inline-flex align-items-center justify-content-center flex-shrink-0" 
        style="cursor: pointer; width: 14px; height: 14px;"
        {% if file.state.value == 'open' %}
          data-bs-toggle="modal" 
          href="#modalTagForm"
          data-drive-action="open-tag-modal"
          data-tag-modal-form-id="{{ file.id }}"
          data-tag-modal-form-value="{{ file.tag ? file.tag.id : '' }}"
          data-bs-toggle="tooltip"
          title="{{ file.tag ? file.tag.name : 'Ajouter une étiquette' }}"
        {% endif %}
      >
        {% if file.tag %}
          <span class="rounded-circle shadow-sm bg-{{ file.tag.color.value }}" style="width: 12px; height: 12px;"></span>
        {% else %}
          <span class="rounded-circle border border-secondary border-dashed opacity-50 hover-opacity-100" style="width: 12px; height: 12px;"></span>
        {% endif %}
      </span>
    </div>
  </th>
  <td>
    {{ file.size|file_formatted_size }}
  </td>
  <td>
    <span class="text-muted">
      {{ file.updatedAt ? file.updatedAt|human_datetime : file.createdAt|human_datetime }}
    </span>
  </td>
  <td>
    <div class="d-flex gap-3 justify-content-center align-items-center">
      {# Bouton Épingler #}
      <span class="file-favourite-btn" style="cursor: pointer;" data-drive-action="pin-file" data-item-id="{{ file.id }}">
        <i class="{{ file.isPinned ? 'ri-star-fill text-warning' : 'ri-star-line text-muted' }} fs-13 align-bottom" title="Épingler le fichier"></i>
      </span>
      
      <div class="dropdown">              
        <button type="button" class="btn btn-light btn-icon btn-sm dropdown shadow-none" title="Plus d'options" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="ri-more-fill align-bottom"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="font-size: 14px;">
          <li>
            <a 
              class="dropdown-item d-flex align-items-center gap-2" 
              href="#" 
              data-drive-action="rename-file" 
              data-item-id="{{ file.id }}" 
              data-item-name="{{ file.niceName ?: file.originalName }}"
            >
              <i class="ri-pencil-line text-muted"></i> Renommer
            </a>
          </li>
          <li>
            <a 
              class="dropdown-item d-flex align-items-center gap-2" 
              href="#" 
              data-drive-action="download-file" 
              data-item-id="{{ file.id }}"
            >
              <i class="ri-download-2-line text-muted"></i> Télécharger
            </a>
          </li>
          
          <li><hr class="dropdown-divider"></li>
          
         <li>
            <a 
              class="dropdown-item d-flex align-items-center gap-2" 
              href="#modalTagForm" 
              data-bs-toggle="modal" 
              data-drive-action="open-tag-modal"
              data-tag-modal-form-id="{{ file.id }}"
              data-tag-modal-form-value="{{ file.tag ? file.tag.id : '' }}"
            >
              <i class="ri-price-tag-3-line text-muted"></i>
              Modifier l'étiquette
            </a>
          </li>
          
          <li><hr class="dropdown-divider"></li>

          {% if file.state.value == 'archive' or file.state.value == 'trash' %}
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2" href="#" data-drive-action="restore-file" data-item-id="{{ file.id }}">
                <i class="ri-arrow-go-back-line"></i> Restaurer
              </a>
            </li>
          {% else %}
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 link-warning" href="#" data-drive-action="archive-file" data-item-id="{{ file.id }}">
                <i class="ri-archive-line"></i> Archiver
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center gap-2 link-danger" href="#" data-drive-action="trash-file" data-item-id="{{ file.id }}">
                <i class="ri-delete-bin-line"></i> Corbeille
              </a>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </td>
</tr>