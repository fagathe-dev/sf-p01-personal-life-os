{# templates/app/drive/index.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Mon Drive{% endblock %}

{% block content %}
  <div class="container-fluid py-4" style="max-width: 1000px;">
    
    {# En-tête #}
    <div class="row mb-4 align-items-center">
      <div class="col">
        <h1 class="h3 mb-0 text-gray-800">Mon Drive</h1>
      </div>
      <div class="col-auto">
        <div class="btn-group">
          <button class="btn btn-primary btn-sm dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="ri-add-line align-middle me-1"></i> Ajouter
          </button>
          <div class="dropdown-menu dropdown-menu-end shadow border-0">
            <label class="dropdown-item mb-0" for="fileAddInput" style="cursor:pointer;">
              <i class="ri-file-upload-line text-muted me-2"></i> Importer un fichier
            </label>
            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#modalFolderForm">
              <i class="ri-folder-add-line text-muted me-2"></i> Créer un dossier
            </a>
          </div>
        </div>
      </div>
    </div>

    <div id="b-drive-root">
      
      {# --- SECTION DOSSIERS --- #}
      <section id="b-drive-folders-container" class="bg-white p-3 mb-4 rounded shadow-sm border border-light">
        <h2 class="h6 text-uppercase text-muted fw-bold mb-3">Mes Dossiers</h2>
        
        <div class="table-responsive">
          <table class="table table-nowrap table-borderless align-middle mb-0">
            <thead class="text-muted fs-13">
              <tr>
                <th scope="col" style="width: 50%;">Nom</th>
                <th scope="col">Taille</th>
                {# <th scope="col">Date de modification</th> #}
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody id="b-drive-folders-list">
              {% for folder in folders|default([]) %}
                {% include 'app/drive/components/_folder.html.twig' %}
              {% else %}
                <tr id="empty-folder-row"><td colspan="4" class="text-center text-muted py-4">Aucun dossier</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      {# --- SECTION FICHIERS --- #}
      <section id="b-drive-files-container" class="bg-white p-3 mb-4 rounded shadow-sm border border-light">
        <h2 class="h6 text-uppercase text-muted fw-bold mb-3">Mes Fichiers</h2>
        
        <div class="table-responsive" style="overflow-x: unset;">
          <table class="table table-nowrap table-borderless align-middle mb-0">
            <thead class="text-muted fs-13">
              <tr>
                <th scope="col" style="width: 50%;">Nom</th>
                <th scope="col">Taille</th>
                <th scope="col">Date de modification</th>
                <th scope="col" class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="b-drive-files-list">
              {% for file in files|default([]) %}
                {% include 'app/drive/components/_file.html.twig' %}
              {% else %}
                <tr id="empty-file-row"><td colspan="4" class="text-center text-muted py-4">Aucun fichier</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </div>
  
  {# Modals & Upload form #}
  {% include 'app/drive/forms/_folder-form.html.twig' %}
  {% include 'app/drive/forms/_file-form.html.twig' %}
  {% include 'app/drive/forms/_tag-form.html.twig' %}
  {% include 'app/drive/components/_upload-toaster.html.twig' %}
{% endblock %}

{% block js %}
  <script src="{{ asset('js/pages/app/drive.js') }}"></script>
{% endblock %}