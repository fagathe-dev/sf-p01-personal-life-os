{{ form_start(form) }}
  <div class="row">
    <div class="col-lg-8">
      <div class="col-12 mb-3">
        {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
        {{ form_widget(form.title, {'attr': {'class': 'form-control form-control-lg'}}) }}
        {{ form_errors(form.title) }}
      </div>
      <div class="col-12 mb-4">
        {{ form_label(form.content, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
        {{ form_widget(form.content, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.content) }}
      </div>
    </div>
    {# 1. Le Tag (via CustomSelector) #}
    <div class="col-lg-4">
      {# 1. Le Tag (via CustomSelector) #}
      <div class="mb-3">
        {{ form_label(form.tag, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
        {% include 'components/_custom-dropdown-select.html.twig' with {
          'field': form.tag,
          'cds_mode': 'single-nullable',
          'cds_placeholder': 'Sélectionner une étiquette...'
        } %}
      </div>

      {# 2. La Couleur (via SelectableField et color-swatch) #}
      <div class="mb-3">
        <label class="form-label fw-medium">Couleur de la note</label>
        
        {# Ajout de la classe custom-form-selectable comme dans tag.html.twig #}
        <div class="form-selectable custom-form-selectable js-color-selectable-container d-flex flex-wrap gap-2">
          {% for child in form.color %}
            <div class="form-selectable-item">
              <input type="radio" 
                id="{{ child.vars.id }}" 
                name="{{ child.vars.full_name }}" 
                value="{{ child.vars.value }}" 
                class="form-selectable-input d-none"
                {% if child.vars.checked %}checked="checked"{% endif %}>
                
              {# Rendu visuel de la pastille avec color-swatch #}
              <label class="form-selectable-label color-swatch bg-{{ child.vars.value }}-subtle" 
                for="{{ child.vars.id }}"
                title="{{ child.vars.label }}">
              </label>
            </div>
          {% endfor %}
        </div>
        
        {% do form.color.setRendered() %}
        {{ form_errors(form.color) }}
      </div>
      
    </div>
    <div class="col-auto">
      {{ form_widget(form.save) }}
      <a href="{{ path('app_note_manage') }}" class="btn btn-light ms-2">Annuler</a>
    </div>
  </div>
{{ form_end(form) }}