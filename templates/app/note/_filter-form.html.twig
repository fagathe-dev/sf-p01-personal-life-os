{# templates/app/note/_filter-form.html.twig #}

{# On vérifie si un filtre est présent dans l'URL #}
{% set hasFilter = app.request.query.get('q') or app.request.query.get('t') or app.request.query.get('c') %}

<div class="d-flex justify-content-end mb-3">
  <button class="btn btn-sm {{ hasFilter ? 'btn-soft-primary' : 'btn-ghost-secondary' }} d-flex align-items-center gap-1" 
    type="button" 
    data-bs-toggle="collapse" 
    data-bs-target="#collapseFilterForm" 
    aria-expanded="{{ hasFilter ? 'true' : 'false' }}" 
    aria-controls="collapseFilterForm">
    <i class="ri-filter-3-line"></i>
    {{ hasFilter ? 'Filtres actifs' : 'Afficher les filtres' }}
  </button>
</div>

<div class="collapse {{ hasFilter ? 'show' : '' }}" id="collapseFilterForm">
  <div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
      <form action="{{ path('app_note_manage') }}" onsubmit="event.preventDefault();" method="GET" id="note-search-filter-form" class="row g-3 align-items-center">
          
        {# 1. Recherche Fulltext (q) #}
        <div class="col-md-12 col-lg-4">
          <div class="search-box">
            <input type="text" name="q" value="{{ app.request.query.get('q') }}" class="form-control bg-white border-light" placeholder="Rechercher une note...">
            <i class="ri-search-line search-icon"></i>
          </div>
        </div>
        
        {# 2. Étiquettes (t) #}
        <div class="col-md-6 col-lg-3">
          <select name="t" class="form-select bg-white border-light">
            <option value="">Toutes les étiquettes</option>
            {% for tag in userTags %}
              <option value="{{ tag.id }}" {{ app.request.query.get('t') == tag.id ? 'selected' : '' }}>
                {{ tag.name }}
              </option>
            {% endfor %}
          </select>
        </div>

        {# 3. Couleurs (c) #}
        <div class="col-md-6 col-lg-5">
          <span class="text-muted fs-13">Couleur :</span>
          <div class="d-flex align-items-center gap-2">
            <div class="form-selectable custom-form-selectable d-flex flex-wrap gap-2" id="color-filter-selectable" data-ds-selectable-card-behavior="radio">

              <div class="form-selectable-item">
                  <input 
                    type="radio" 
                    class="form-selectable-input d-none" 
                    name="c" 
                    value=""
                  >
                  <label 
                    class="form-selectable-label color-swatch bg-white" 
                    for=""
                    title="None"
                  ></label>
                </div>

              {% for color in colors %}
                <div class="form-selectable-item {{ app.request.query.get('c') == color.value ? 'active' : '' }}">
                  <input 
                    type="radio" 
                    class="form-selectable-input d-none" 
                    name="c" value="{{ color.value }}" 
                    {{ app.request.query.get('c') == color.value ? 'checked' : '' }}
                  >
                  <label 
                    class="form-selectable-label color-swatch bg-{{ color.value }}-subtle" 
                    for="{{ color.value }}"
                    title="{{ color.name }}"
                  ></label>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        {# Lien pour réinitialiser si des filtres sont présents #}
        {% if hasFilter %}
          <div class="col-12 text-end mt-0">
            <a href="{{ path('app_note_manage') }}" class="text-muted fs-12 text-decoration-none">
              <i class="ri-refresh-line align-bottom"></i> Réinitialiser les filtres
            </a>
          </div>
        {% endif %}

        <button type="submit" class="btn btn-primary">Appliquer les filtres</button>
      </form>
    </div>
  </div>
</div>