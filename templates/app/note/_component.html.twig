{# templates/app/note/_component.html.twig #}

{# Ajout d'un attribut de données unique pour identifier l'élément conteneur complet de la note #}
<div class="card border-0 shadow-sm note-card h-100 {{ note.color ? 'bg-' ~ note.color.value ~ '-subtle' : 'bg-white' }}" data-note-container data-note-id="{{ note.id }}">
    
  {# 📌 Bouton Épingler #}
  <button 
    class="btn btn-sm btn-icon pin-button position-absolute top-0 end-0 m-2 z-1 shadow-none"
    data-action="pinned"
    data-id="{{ note.id }}"
    title="{{ note.isPinned ? 'Désépingler' : 'Épingler' }}"
  >
    <i class="{{ note.isPinned ? 'ri-pushpin-2-fill text-warning' : 'ri-pushpin-2-line text-muted' }} fs-5"></i>
  </button>

  {# 📝 Corps de la note (Édition) #}
  <a href="{{ path('app_note_edit', {'id': note.id}) }}" class="card-body text-decoration-none text-body" style="cursor: pointer;">
    {% if note.title %}
      <h6 class="card-title fw-bold mb-2 pe-4">{{ note.title }}</h6>
    {% endif %}

    <div class="card-text text-muted fs-14 note-content-preview" data-note-raw-content="{{ note.content|default('')|word_wrap(160)|e('html_attr') }}">
      {# Injecté par le script JS via convertMarkdownToHtml #}
    </div>
  </a>

  {# 🏷️ Footer : Tag & Dropdown #}
  <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center pt-0 pb-2">
    <div class="note-tags">
      {% if note.tag %}
        <span class="badge border border-light text-body bg-white shadow-sm py-1 px-2">
          {% if note.tag.color %}
            <span class="rounded-circle d-inline-block me-1 bg-{{ note.tag.color.value }}" style="width: 6px; height: 6px;"></span>
          {% endif %}
          {{ note.tag.name }}
        </span>
      {% endif %}
    </div>

    {# ⚙️ Quick Actions (Dropdown) #}
    <div class="dropdown quick-actions-dropdown">
      <button class="btn btn-sm btn-icon text-muted shadow-none p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="ri-more-2-fill fs-5"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="font-size: 14px;">
        {% if note.state.value == 'archive' or note.state.value == 'trash' %}
          <li>
            {# 👈 Changement de data-action="archive" par "restore-note" #}
            <a class="dropdown-item d-flex align-items-center gap-2" href="#" data-action="restore-note" data-id="{{ note.id }}">
              <i class="ri-arrow-go-back-line"></i> Restaurer
            </a>
          </li>
        {% else %}  
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2" href="#" data-action="archive" data-id="{{ note.id }}">
              <i class="ri-archive-line text-muted"></i> Archiver
            </a>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="#" data-action="trash" data-id="{{ note.id }}">
              <i class="ri-delete-bin-line"></i> Corbeille
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>
</div>