{# templates/app/note/create.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Nouvelle note{% endblock %}

{% block content %}
  <div class="container-fluid py-4" style="max-width: 800px;">
    <div class="d-flex align-items-center mb-4">
      <h1 class="h3 mb-0">Créer une note</h1>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        {% include 'app/note/_form.html.twig' %}
      </div>
    </div>
  </div>
{% endblock %}

{% block js %}
  <script src="{{ asset('js/pages/app/note.js') }}"></script>
{% endblock %}