{# templates/app/todo/index.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Mes Tâches{% endblock %}

{% block content %}
  <div class="container-fluid py-4" style="max-width: 900px;">
    
    {# En-tête #}
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="h2 mb-0 fw-bold text-gray-800">
        {{ currentTag ? 'Étiquette : ' ~ currentTag.name : 'Aujourd\'hui' }}
      </h1>
    </div>

    {# Formulaire d'ajout rapide (Fixe en haut) #}
    <div class="card shadow-sm border mb-5" style="border-radius: 0.75rem;">
      <div class="card-body p-2">
        {{ form_start(quickAddForm, {'attr': {'id': 'quick-add-form', 'class': 'd-flex align-items-center gap-2'}}) }}
          
          <button type="button" class="btn btn-light btn-sm d-flex align-items-center gap-2 text-muted fw-medium px-3" style="border-radius: 0.5rem;">
            <i class="bx bx-calendar fs-6"></i> Aujourd'hui
          </button>

          {{ form_widget(quickAddForm.title, {
            'attr': {
              'class': 'form-control border-0 shadow-none bg-transparent px-2 fs-6',
              'placeholder': 'Exemple : Acheter du lait...',
              'autocomplete': 'off'
            }
          }) }}
          
          <button type="submit" class="btn btn-primary btn-icon rounded-circle flex-shrink-0" style="width: 36px; height: 36px;">
            <i class="bx bx-plus fs-4"></i>
          </button>
          
        {{ form_end(quickAddForm) }}
      </div>
    </div>

    <div class="todo-content">
      
      {# --- SECTIONS DES TÂCHES ACTIVES --- #}
      {% if activeGroups|length > 0 %}
          
          {% for groupId, group in activeGroups %}
              <div class="mb-5">
                  {# Titre de la section avec le code couleur demandé #}
                  <div class="d-flex align-items-center mb-3">
                      {% if groupId == 'overdue' %}
                          {# En retard : Rouge #}
                          <h5 class="mb-0 fs-6 fw-bold text-danger d-flex align-items-center gap-2">
                              <i class="bx {{ group.icon }} fs-5"></i> {{ group.label }}
                          </h5>
                      {% else %}
                          {# Reste : Titre et icône en blanc dans un conteneur sombre pour la lisibilité #}
                          <h5 class="mb-0 fs-6 fw-bold text-white bg-slate-800 px-3 py-1 rounded d-flex align-items-center gap-2" style="background-color: #1e293b;">
                              <i class="bx {{ group.icon }} fs-5"></i> {{ group.label }}
                          </h5>
                      {% endif %}
                      <span class="ms-3 text-muted fs-6 fw-medium">{{ group.todos|length }}</span>
                  </div>

                  {# Liste des tâches de la section #}
                  <div class="list-group shadow-sm border" style="border-radius: 0.75rem; overflow: hidden;">
                      {% for task in group.todos %}
                          {% include 'app/todo/_component.html.twig' with {'task': task} %}
                      {% endfor %}
                  </div>
              </div>
          {% endfor %}

      {% else %}
          {# État vide global si tout est fait #}
          <div id="empty-active-state" class="list-group-item text-center text-muted py-5 border-0 bg-transparent">
            <i class="bx bx-check-circle display-4 d-block mb-2 opacity-50"></i>
            Aucune tâche à faire. Profitez de votre journée !
          </div>
      {% endif %}


      {# --- SECTION DES TÂCHES TERMINÉES --- #}
      {# Reste pliée par défaut comme demandé #}
      <div id="completed-tasks-container" class="mt-5 {{ completedTasks|length == 0 ? 'd-none' : '' }}">
        <div class="d-flex align-items-center mb-3" data-bs-toggle="collapse" data-bs-target="#completedTasks" style="cursor: pointer;">
          <h5 class="mb-0 fs-6 text-muted fw-semibold d-flex align-items-center gap-1">
            <i class="bx bx-chevron-right fs-5"></i> Terminées
          </h5>
          <span class="badge bg-secondary-subtle text-secondary ms-2 rounded-pill" id="completed-tasks-count">{{ completedTasks|length }}</span>
        </div>
        
        <div class="collapse" id="completedTasks"> {# collapse sans le "show" pour que ce soit plié par défaut #}
          <div class="list-group shadow-sm border opacity-75" id="completed-tasks-list" style="border-radius: 0.75rem; overflow: hidden;">
            {% for task in completedTasks %}
              {% include 'app/todo/_component.html.twig' with {'task': task} %}
            {% endfor %}
          </div>
        </div>
      </div>

    </div>
  </div>
{% endblock %}

{% block js %}
  <script src="{{ asset('js/pages/app/todo.js') }}"></script>
{% endblock %}