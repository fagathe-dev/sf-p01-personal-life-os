{# templates/app/todo/_component.html.twig #}
{# @var task \App\Entity\Task #}

<div data-task-container data-task-id="{{ task.id }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-start-0 border-end-0">
    
  {# 1. À gauche : Le Checkbox Natif #}
  <div class="todo-check flex-shrink-0">
    <input 
      type="checkbox" 
      class="form-check-input fs-5" 
      data-todo-completed-toggler 
      data-task-id="{{ task.id }}" 
      {{ task.isCompleted ? 'checked' : '' }}
      style="cursor: pointer; margin-top: 0;"
    >
  </div>

  {# 2. Au centre : Le contenu (Cliquable pour éditer) #}
  <div class="flex-grow-1 overflow-hidden" style="cursor: pointer;" onclick="window.location.href='{{ path('app_todo_edit', {'id': task.id}) }}'">
    <div class="d-flex align-items-center mb-1">
      <h6 class="mb-0 text-truncate {{ task.isCompleted ? 'text-decoration-line-through text-muted opacity-75' : 'text-body' }}" style="font-size: 15px;">
        {{ task.title }}
      </h6>
            
      {# Utilisation du nouveau filtre Twig pour la priorité #}
      {{ task.priority|todo_priority_badge }}
    </div>
        
    {# Métadonnées : Date et Tags #}
    <div class="d-flex flex-wrap gap-2 align-items-center mt-1">
      {% if task.dueDate %}
        <span class="text-muted" style="font-size: 12px;">
          <i class="ri-calendar-event-line align-bottom me-1"></i>
          {{ task.dueDate|human_datetime }}
        </span>
      {% endif %}
        
      {% for tag in task.tags %}
        <span class="badge border border-light text-body d-flex align-items-center gap-1" style="font-size: 11px; font-weight: normal;">
          <span class="rounded-circle d-inline-block" style="width: 8px; height: 8px; background-color: var(--vz-{{ tag.color.value|default('primary') }});"></span>
          {{ tag.name|default('Tag') }}
        </span>
      {% endfor %}
    </div>
  </div>

  {# 3. À droite : L'épingle et le menu d'actions #}
  <div class="flex-shrink-0 d-flex align-items-center gap-2">
    {# Le bouton épingler (reste inchangé, géré par délégation globale) #}
    <a href="#" class="btn btn-sm btn-icon btn-ghost-secondary fs-18 {{ task.isPinned|default(false) ? 'text-warning' : 'text-muted' }}">
      <i class="ri-pushpin-2-{{ task.isPinned|default(false) ? 'fill' : 'line' }}"></i>
    </a>
    
    {# Menu contextuel #}
    <div class="dropdown">
      <button class="btn btn-sm btn-icon btn-ghost-secondary fs-16" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="ri-more-2-fill"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm">
        <li>
          <a class="dropdown-item" href="{{ path('app_todo_edit', {'id': task.id}) }}">
            <i class="ri-pencil-line align-bottom me-2 text-muted"></i> Modifier
          </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <form action="{{ path('app_todo_delete', {'id': task.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette tâche ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
            <button type="submit" class="dropdown-item text-danger">
              <i class="ri-delete-bin-line align-bottom me-2"></i> Supprimer
            </button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</div>