{# templates/app/todo/_component.html.twig #}
{# @var task \App\Entity\Todo #}

<div data-task-container data-task-id="{{ task.id }}" class="list-group-item list-group-item-action py-3 border-start-0 border-end-0 hover-surface transition-all" style="cursor: pointer;">
    
  <div class="d-flex align-items-start gap-3">
      {# 1. À gauche : Le Checkbox aligné en haut #}
      <div class="todo-check flex-shrink-0 mt-1">
        <input 
          type="checkbox" 
          class="form-check-input fs-5 m-0" 
          data-todo-completed-toggler 
          data-task-id="{{ task.id }}" 
          {{ task.isCompleted ? 'checked' : '' }}
          style="cursor: pointer; border-width: 2px; border-color: var(--ds-{{ task.tag ? task.tag.color.value : 'primary' }}); {{ task.isCompleted ? 'background-color: var(--ds-' ~ (task.tag ? task.tag.color.value : 'primary') ~ ');' : '' }}"
        >
      </div>

      {# 2. Au centre : Le contenu #}
      <div class="flex-grow-1 overflow-hidden" onclick="window.location.href='{{ path('app_todo_edit', {'id': task.id}) }}'">
        
        {# Ligne Supérieure : Titre #}
        <h6 class="mb-2 text-truncate {{ task.isCompleted ? 'text-decoration-line-through text-muted opacity-75' : 'text-body' }} fw-medium" style="font-size: 16px;">
          {{ task.title }}
        </h6>
            
        {# Ligne Inférieure : Métadonnées (Tag, Date, Comms, Sous-tâches) #}
        <div class="d-flex flex-wrap gap-3 align-items-center mt-1" style="font-size: 13.5px;">
            
          {# (1) Couleur du tag fusionnée au texte #}
          {% if task.tag %}
            <span style="color: var(--ds-{{ task.tag.color.value|default('primary') }}); font-weight: 600;">
              #{{ task.tag.name }}
            </span>
          {% endif %}

          {# (2) Picto calendrier + mention via le nouveau filtre Twig #}
          {% if task.dueDate %}
            {% set status = task.dueDate|todo_due_status %}
            {% if status %}
                <span class="d-flex align-items-center gap-1 text-{{ status.color }} {{ status.color == 'danger' ? 'fw-bold' : 'text-muted' }}">
                    <i class="bx {{ status.icon }} fs-6"></i> {{ status.label }}
                </span>
            {% endif %}
          {% endif %}
            
          {# (3) Picto commentaires (statique pour l'instant) #}
          <span class="d-flex align-items-center gap-1 text-muted">
            <i class="bx bx-message-rounded-dots fs-6"></i> 0/0
          </span>

          {# (4) Picto sous-tâches (statique pour l'instant) #}
          <span class="d-flex align-items-center gap-1 text-muted">
            <i class="bx bx-check-square fs-6"></i> 0/0
          </span>

        </div>
      </div>

      {# 3. À droite : Le menu d'actions #}
      <div class="flex-shrink-0 d-flex align-items-center gap-2">
        <div class="dropdown">
          <button class="btn btn-sm btn-icon btn-ghost-secondary fs-16" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bx bx-dots-vertical-rounded"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm">
            <li>
              <a class="dropdown-item" href="{{ path('app_todo_edit', {'id': task.id}) }}">
                <i class="bx bx-pencil align-bottom me-2 text-muted"></i> Modifier
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="{{ path('app_todo_delete', {'id': task.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette tâche ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                <button type="submit" class="dropdown-item text-danger">
                  <i class="bx bx-trash align-bottom me-2"></i> Supprimer
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
  </div>
</div>